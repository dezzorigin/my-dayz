# MyDayz — contoh environment. Salin ke `.env.local` (JANGAN commit .env*).
#
# GEMINI_API_KEY — kunci Gemini AI untuk AI Assistant (/api/chat).
#   Tanpa kunci, aplikasi tetap jalan penuh; AI menjawab 503 dengan pesan
#   yang jelas. Di Cloudflare Pages, pasang sebagai environment variable
#   (Settings → Environment variables) — BUKAN di file ini.
#   Dapatkan kunci di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY — sinkronisasi
# cloud Supabase. OPSIONAL dan BELUM AKTIF (lihat src/lib/supabase.ts):
# tanpa keduanya, MyDayz berjalan local-first di localStorage browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
